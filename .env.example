# Localmente: copie para .env. Na Vercel: Project Settings > Environment Variables.

# Senha do painel (obrigatória na Vercel; localmente, sem ela, o login fica desativado).
APP_PASSWORD=
# Segredo que a Vercel envia ao chamar /api/cron (gere um valor aleatório longo).
CRON_SECRET=

# Mercado Livre (Dev Center): https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Upstash Redis: criadas automaticamente ao conectar o banco pelo painel da Vercel.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Valores iniciais das notificações (também configuráveis pela interface).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

PORT=3000
INTERVAL_MINUTES=60
